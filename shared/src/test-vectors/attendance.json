      "date": "2024-06-15",
      "events": [
        { "id": "e1", "direction": "IN", "timestamp": "2024-06-15T06:00:00+02:00", "isCorrection": false }
      ]
    },
    "expected": { "minutesOnSite": 0, "missingClockOut": true, "missingClockIn": false, "eventCount": 1 }
  },
  {
    "description": "Missing clock-in: OUT present, no IN",
    "input": {
      "partial": { "employeeId": "emp-1", "employeeName": "Test Employee", "employeeNumber": "EMP001", "department": "Brewing", "siteId": "site-1" },
      "date": "2024-06-15",
      "events": [
        { "id": "e2", "direction": "OUT", "timestamp": "2024-06-15T14:00:00+02:00", "isCorrection": false }
      ]
    },
    "expected": { "minutesOnSite": 0, "missingClockOut": false, "missingClockIn": true, "eventCount": 1 }
